<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>parcelnumbergenerator-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ParcelNumberGenerator.Data/ParcelNumberGenerator.Data.csproj" />
    <ProjectReference Include="../ParcelNumberGenerator.Domain/ParcelNumberGenerator.Domain.csproj" />
    <ProjectReference Include="../ParcelNumberGenerator.ServiceDefaults/ParcelNumberGenerator.ServiceDefaults.csproj" />
    <!-- Referenced so both migration sets ship in the image and DATABASE_PROVIDER can pick
         either one at runtime without a rebuild. -->
    <ProjectReference Include="../ParcelNumberGenerator.Migrations.PostgreSQL/ParcelNumberGenerator.Migrations.PostgreSQL.csproj" />
    <ProjectReference Include="../ParcelNumberGenerator.Migrations.SqlServer/ParcelNumberGenerator.Migrations.SqlServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ParcelNumberGenerator.Tests" />
  </ItemGroup>

</Project>
