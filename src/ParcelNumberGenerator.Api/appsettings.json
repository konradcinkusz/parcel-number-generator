{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Pool": {
    "From": 1,
    "To": 9999999,
    "Exclusions": []
  },

  "Allocation": {
    "Strategy": "adaptive",
    "MaxAttempts": 0,
    "MaxBatchSize": 1000
  }
}
